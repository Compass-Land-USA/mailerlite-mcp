# Copy to .env (chmod 600) and fill in. Read by systemd (EnvironmentFile) and `npm start`.
MAILERLITE_API_KEY=
# openssl rand -hex 32
MCP_BEARER_TOKEN=
# Shared team password asked for when connecting. openssl rand -base64 18
MCP_LOGIN_PASSWORD=
PORT=3100
# Gateway of the n8n-server Docker network, so the Caddy container can reach it
HOST=172.19.0.1
